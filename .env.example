# =============================================================================
# OneSeiMangkeiSEZ environment variables. Copy to .env.local for local development.
# NEVER commit real secrets. Production values come from the approved secret store.
# =============================================================================

# --- Runtime environment ------------------------------------------------------
# Logical deployment environment: development | staging | production.
# Controls which catalogue entries are visible (an app's `environment` must match)
# and forbids the mock identity adapter when set to "production".
APP_ENV=development

# Public base URL of the portal (used for OIDC redirect URIs and Origin checks).
PORTAL_BASE_URL=http://localhost:3100

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string for portal-owned metadata (catalogue, org mapping,
# entitlements, audit events). Local value matches the local Supabase stack
# (supabase/config.toml, `pnpm db:up`).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54362/postgres
# Separate database used by integration/E2E tests (created by `pnpm db:test:init`).
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54362/onekinra_test

# --- Session ------------------------------------------------------------------
# Secret used to encrypt the session cookie (A256GCM). Minimum 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-value-at-least-32-chars
# Absolute session lifetime in seconds (default 8 hours).
SESSION_MAX_AGE_SECONDS=28800

# --- Identity provider --------------------------------------------------------
# "oidc" for a real IAM provider (ZITADEL / Keycloak), "mock" for LOCAL DEVELOPMENT ONLY.
AUTH_PROVIDER=mock
# Must be "true" for the mock adapter to work. Ignored (refused) when APP_ENV=production.
MOCK_AUTH_ENABLED=true

# OIDC settings (required when AUTH_PROVIDER=oidc). Values come from the IAM provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE only). Set for a confidential client.
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# How organization memberships and roles are read from ID-token claims:
#   zitadel  -> urn:zitadel:iam:org:project:roles  ({ role: { orgId: orgDomain } })
#   generic  -> claim named by OIDC_MEMBERSHIPS_CLAIM: [{ "org": "<id>", "roles": ["..."] }]
OIDC_CLAIM_MAPPING=zitadel
OIDC_MEMBERSHIPS_CLAIM=onekinra_memberships

# --- Application launch safety ------------------------------------------------
# Comma-separated host allowlist for catalogue target URLs. "*.example.com" matches
# subdomains only. Demo seed data uses *.kinra.example (reserved, non-resolving TLD).
APP_URL_ALLOWED_HOSTS=*.kinra.example
# Allow http:// target URLs. Keep false outside local development.
APP_URL_ALLOW_HTTP=false

# --- AI assistant (workspace) -------------------------------------------------
# Claude API key for the "Asisten OneSeiMangkeiSEZ" panel on the workspace. Leave empty to
# disable (the panel then explains that the assistant is not configured).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# --- News feeds ----------------------------------------------------------------
# Token for POST /api/internal/news-sync (called by an external scheduler, e.g. cron every
# 30 minutes). Empty = endpoint disabled; admins can still use "Sinkronkan sekarang".
# Generate: openssl rand -base64 48
NEWS_SYNC_TOKEN=
